# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your machine:
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Used by the backend and mapped into the `db` container by docker compose.
# DB_HOST is for running the backend locally; compose overrides it to `db`.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app
# Change this before using the project outside your machine.
DB_PASSWORD=change-me
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# ---------------------------------------------------------------------------
# Backend (Go + Fiber)
# ---------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Run database migrations automatically when the backend starts.
DB_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Public base URL of the backend API, consumed by the browser. It is baked
# into the frontend bundle at build time, so rebuild the image after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_PORT=3000
